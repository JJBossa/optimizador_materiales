# Plantilla de variables; Django no carga este archivo automáticamente.
# Para producción: CUTLESS_ENV=production y clave aleatoria privada de 50+ caracteres.
CUTLESS_ENV=development
CUTLESS_SECRET_KEY=
CUTLESS_ALLOWED_HOSTS=localhost,127.0.0.1
CUTLESS_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Activar solo si un proxy controlado elimina y fija X-Forwarded-Proto.
CUTLESS_TRUST_PROXY_HEADERS=false
# CUTLESS_DB_PATH=C:/ruta/privada/db.sqlite3
# CUTLESS_MEDIA_ROOT=C:/ruta/privada/media
# Recuperación de contraseña por HTTPS en producción (sin SMTP).
# CUTLESS_BREVO_RECOVERY_ENABLED=false
# CUTLESS_BREVO_RECOVERY_MODE=queue
# CUTLESS_PASSWORD_RESET_HOST=cutless.example.com
# CUTLESS_BREVO_API_KEY=
# CUTLESS_BREVO_SENDER_EMAIL=recuperacion@example.com
# CUTLESS_BREVO_SENDER_NAME=CutLess
# CUTLESS_RECOVERY_QUEUE_CONSUMER_ENABLED=false
# CUTLESS_RECOVERY_QUEUE_ACCOUNT_ID=
# CUTLESS_RECOVERY_QUEUE_ID=
# CUTLESS_RECOVERY_QUEUE_API_TOKEN=
# CUTLESS_RECOVERY_QUEUE_ENCRYPTION_KEY=
# CUTLESS_RECOVERY_QUEUE_HMAC_KEY=
# Correo general de Django, independiente de la recuperación en producción.
# CUTLESS_EMAIL_HOST=smtp.example.com
# CUTLESS_EMAIL_PORT=587
# CUTLESS_EMAIL_HOST_USER=
# CUTLESS_EMAIL_HOST_PASSWORD=
# CUTLESS_DEFAULT_FROM_EMAIL=CutLess <noreply@example.com>


# PostgreSQL / Supabase: configurar en el entorno privado de producción.
# Valores ilustrativos; estas líneas están comentadas y no configuran una conexión.
# CUTLESS_DB_ENGINE=postgresql
# CUTLESS_DB_NAME=postgres
# CUTLESS_DB_USER=usuario_obtenido_del_panel
# CUTLESS_DB_PASSWORD=definir_en_el_entorno_privado
# CUTLESS_DB_HOST=host_obtenido_del_panel
# CUTLESS_DB_PORT=5432
# CUTLESS_DB_SSLMODE=require
# CUTLESS_DB_SSLROOTCERT=/ruta/al/certificado.crt
# Para SQLite en desarrollo no se requiere ninguna de estas variables.
