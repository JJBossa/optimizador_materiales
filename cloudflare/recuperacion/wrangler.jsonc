{
  "name": "cutless-recuperacion-consumer",
  "main": "worker.mjs",
  "compatibility_date": "2026-01-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "queues": {
    "consumers": [
      {
        "queue": "cutless-recuperacion",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_concurrency": 1,
        "max_retries": 3,
        "retry_delay": 90
      }
    ]
  }
}
